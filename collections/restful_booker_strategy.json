{
  "info": {
    "_postman_id": "4f3fc2ed-6d85-43d0-ad0a-e2af3f841b69",
    "name": "Restful-Booker-Estrategia",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "02 - Gestao de Reservas",
      "item": [
        {
          "name": "Criar Reserva (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('current_booking_id', jsonData.bookingid);",
                  "console.log('ID da reserva capturado: ' + jsonData.bookingid);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"Nayum\",\n    \"lastname\": \"Architect\",\n    \"totalprice\": 150,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-05-01\",\n        \"checkout\": \"2026-05-10\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/booking",
              "host": ["{{base_url}}"],
              "path": ["booking"]
            }
          }
        },
        {
          "name": "Consultar Reserva Dinamica (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/booking/{{current_booking_id}}",
              "host": ["{{base_url}}"],
              "path": ["booking", "{{current_booking_id}}"]
            }
          }
        }
      ]
    }
  ]
}